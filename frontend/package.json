{
  "name": "acadly-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@acadly/admin-portal",
    "dev:admin": "turbo run dev --filter=@acadly/admin-portal",
    "dev:student": "turbo run dev --filter=@acadly/student-portal",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@acadly/admin-portal",
    "build:student": "turbo run build --filter=@acadly/student-portal",
    "start": "turbo run start --filter=@acadly/admin-portal",
    "start:student": "turbo run start --filter=@acadly/student-portal",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.21.0",
    "js-cookie": "^3.0.8",
    "next": "16.4.3",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "turbo": "^2.0.0"
  }
}
