# Both portals use this same MySQL database through the NestJS APIs.
NODE_ENV=development
ADMIN_API_PORT=4000
STUDENT_API_PORT=4001

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=acadly
DB_PASSWORD=
DB_DATABASE=acadly

# Set a private random secret before starting the API.
JWT_SECRET=
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:3000,http://localhost:3001